# ------------------------------------------------------------------
# AI Business Opportunity Assessment — environment configuration
# Copy to .env.local for local development. NEVER commit real keys.
# ------------------------------------------------------------------

# Base URL used for report links sent by email
APP_BASE_URL=http://localhost:3000

# SQLite database file (migrations run automatically on boot)
DATABASE_PATH=.data/app.db

# Secret used to sign admin session cookies (generate: openssl rand -hex 32)
APP_SECRET=dev-secret-change-me

# Admin portal credentials (single staff account for MVP)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-production

# Assessment / report link lifetime
ASSESSMENT_TTL_DAYS=7
REPORT_TTL_DAYS=30

# ---- LLM (optional — deterministic fallback works without it) ----
# Any OpenAI-compatible endpoint (OpenAI, GLM, DeepSeek, local gateways…).
# Setting LLM_API_KEY switches report narratives to AI-personalised text;
# all numbers stay engine-computed. If the model fails or returns invalid
# JSON, the report silently falls back to the template — users never see an
# error. Cost is one small call per generated report (~$0.001 each on
# gpt-4o-mini class models). Reports are only generated after lead capture.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Email (optional — "console" provider just logs the link) ----
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="AI Opportunity Assessment <noreply@example.com>"
